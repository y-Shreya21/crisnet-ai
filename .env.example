# =====================================================================
# CrisisNet AI - Environment Configuration Example
# Copy this file to '.env' and fill in your actual credentials.
# =====================================================================

# 1. Google API Credentials (Required for Live Google ADK LLM Agents)
# Get a key from Google AI Studio: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_api_key_here

# 2. News API Credentials (Optional: used to fetch real headlines, fallback to dummy news if unset/invalid)
# Get a key from NewsAPI: https://newsapi.org/
NEWS_API_KEY=e5de58fcd7614443ab5365a0c13eb20b

# 3. Model Configurations
GEMINI_MODEL=gemini-2.5-flash
